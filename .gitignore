# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/
scripts/.geocode-cache.json
scripts/.geocode-cache-gsi.json
scripts/.geocode-failures.txt
scripts/.geocode-coarse.txt
scripts/.unmatched-stores.txt
# Googleマイマップの書き出し（個人の訪問記録を含む。public/ 配下はWeb公開される）
public/*.kmz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
